APP_NAME=doncaster-property-intel
APP_ENV=development
LOG_LEVEL=INFO

WEAVIATE_URL=http://weaviate:8080
WEAVIATE_CLASS_NAME=PropertyDocChunk

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text

FIXED_CHUNK_SIZE=512
FIXED_CHUNK_OVERLAP=50
SEMANTIC_MIN_TOKENS=180
SEMANTIC_MAX_TOKENS=520
SEMANTIC_BREAKPOINT_THRESHOLD=0.72

RETRIEVAL_TOP_K=5
RETRIEVAL_TIMEOUT_SECONDS=30

# Phase 2: hybrid search
# alpha=0 → pure BM25, alpha=1 → pure vector, 0.5 → balanced
HYBRID_ALPHA=0.5
HYBRID_CANDIDATE_MULTIPLIER=3

# Phase 2: reranker
# provider: "local" (cross-encoder, no key needed) or "cohere" (requires COHERE_API_KEY)
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=5
COHERE_API_KEY=

METRICS_LOG_PATH=backend/logs/chunk_quality.jsonl
RETRIEVAL_COMPARISON_LOG_PATH=backend/logs/retrieval_comparison.jsonl

# Phase 3: agent
# Domain.com.au API — leave blank to use stub mode (returns mock listings)
DOMAIN_API_URL=https://api.domain.com.au/v1
DOMAIN_API_KEY=
DOMAIN_LISTINGS_LIMIT=5
# DuckDuckGo web search results per query
WEB_SEARCH_MAX_RESULTS=5
# Per-tool invocation timeout (seconds)
AGENT_TOOL_TIMEOUT_SECONDS=20
# Structured log path for agent tool-call telemetry
AGENT_LOG_PATH=backend/logs/agent_calls.jsonl
